---
const benefits = [
  {
    audience: 'Excel User Benefits',
    tagline: 'Never leave Excel!',
    items: [
      'Run reports directly from any connected system',
      'Run reports as Excel formulas',
      'Search and browse all available reports',
      'All pivot tables refreshed after a report is run',
      'Lightening fast — pull 10,000 rows in miliseconds',
      'No dealing with macros — one-time Add-In install',
    ],
    accent: 'from-brand/20 to-transparent',
  },
  {
    audience: 'Developer Benefits',
    tagline: 'Enhance Excel as the report writer',
    items: [
      'Connect SQL Server, REST APIs, QuickBooks & Salesforce',
      'Write SQL with parameters — dropdowns, combo boxes & dates',
      'Create a searchable taxonomy of reports',
      'Send reports to any Excel user in seconds',
      'Fine-grained user permissioning',
      'Write SQL or an API call once, deliver everywhere',
    ],
    accent: 'from-brand-light/10 to-transparent',
  },
];
---

<section id="about" class="relative py-24 lg:py-32">
  <div class="absolute inset-0 bg-gradient-to-b from-brand/5 via-transparent to-transparent" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <h2 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">
        Built for both sides of the data pipeline
      </h2>
      <p class="mt-4 text-lg text-muted">
        Whether you live in Excel or write the queries behind it, Hygrid bridges the gap.
      </p>
    </div>

    <div class="mt-16 grid gap-8 lg:grid-cols-2">
      {
        benefits.map((group, i) => (
          <div
            class={`reveal reveal-delay-${i + 1} relative overflow-hidden rounded-2xl border border-border bg-surface-card p-8 lg:p-10`}
          >
            <div class={`absolute inset-0 bg-gradient-to-br ${group.accent} pointer-events-none`} aria-hidden="true"></div>
            <div class="relative">
              <span class="text-sm font-semibold tracking-widest text-brand-light uppercase">{group.audience}</span>
              <h3 class="font-display mt-2 text-2xl font-bold text-foreground">{group.tagline}</h3>
              <ul class="mt-6 space-y-3">
                {group.items.map((item) => (
                  <li class="flex items-start gap-3 text-sm text-muted">
                    <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-light" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
