---
interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
}

const { title, subtitle, badge } = Astro.props;
---

<section class="relative overflow-hidden pt-32 pb-16">
  <div class="hero-grid pointer-events-none absolute inset-0 opacity-50" aria-hidden="true"></div>
  <div class="pointer-events-none absolute top-0 left-1/2 h-64 w-96 -translate-x-1/2 rounded-full bg-brand/10 blur-[100px]" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-4xl px-6 text-center lg:px-8">
    {badge && (
      <span class="reveal mb-4 inline-block text-sm font-semibold tracking-widest text-brand-light uppercase">
        {badge}
      </span>
    )}
    <h1 class="reveal reveal-delay-1 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">
      {title}
    </h1>
    {subtitle && (
      <p class="reveal reveal-delay-2 mx-auto mt-5 max-w-2xl text-lg text-muted">{subtitle}</p>
    )}
  </div>
</section>
