---
import Logo from './Logo.astro';
import { navLinks, ctaLink } from '../data/nav';
---

<footer class="border-t border-border py-12">
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 px-6 sm:flex-row lg:px-8">
    <Logo size="sm" />

    <p class="text-center text-sm text-muted">
      &copy; {new Date().getFullYear()} Hygrid.io — Deliver data to Excel in seconds.
    </p>

    <nav class="flex flex-wrap justify-center gap-6" aria-label="Footer navigation">
      <a href="/#excel-features" class="text-sm text-muted transition hover:text-foreground">Excel User Benefits</a>
      <a href="/#developer-features" class="text-sm text-muted transition hover:text-foreground">Developer Benefits</a>
      <a href="/demo-videos" class="text-sm text-muted transition hover:text-foreground">Demo Videos</a>
      <a href={ctaLink.href} class="text-sm text-muted transition hover:text-foreground">{ctaLink.label}</a>
    </nav>
  </div>
</footer>
