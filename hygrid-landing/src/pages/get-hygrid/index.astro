---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Get Hygrid | Hygrid.io"
  description="Get Hygrid and start delivering data directly to Excel. Connect SQL databases and REST APIs to Excel in seconds."
>
  <Header />
  <main>
    <PageHero
      badge="Get Started"
      title="Get Hygrid"
      subtitle="Deliver data to Excel in seconds. Connect your SQL databases and REST APIs so your users never have to export again."
    />

    <section class="pb-24 lg:pb-32">
      <div class="mx-auto max-w-2xl px-6 lg:px-8">
        <div class="reveal rounded-2xl border border-border bg-surface-card p-8 sm:p-10">
          <h2 class="font-display text-xl font-bold text-foreground">Ready to get started?</h2>
          <p class="mt-3 text-muted">
            Contact us to set up Hygrid for your team. We'll help you connect your data sources and get your Excel
            users up and running with live reports.
          </p>

          <div class="mt-8 space-y-4">
            <a
              href="mailto:hello@hygrid.io"
              class="flex items-center justify-center gap-2 rounded-xl bg-brand px-6 py-4 text-base font-semibold text-white shadow-lg shadow-brand/25 transition hover:bg-brand-light"
            >
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              Email hello@hygrid.io
            </a>
            <a
              href="/demo-videos"
              class="flex items-center justify-center gap-2 rounded-xl border border-border px-6 py-4 text-base font-semibold text-foreground transition hover:border-brand/30 hover:bg-foreground/5"
            >
              Watch demo videos first
            </a>
          </div>
        </div>

        <div class="reveal reveal-delay-1 mt-8 grid gap-4 sm:grid-cols-3">
          {
            [
              { label: 'Setup', text: 'One-time Excel Add-In install' },
              { label: 'Connect', text: 'SQL, APIs, QuickBooks & more' },
              { label: 'Deliver', text: 'Live data straight to Excel' },
            ].map((item) => (
              <div class="rounded-xl border border-border bg-surface-raised/50 px-4 py-5 text-center">
                <p class="text-sm font-semibold text-brand-light">{item.label}</p>
                <p class="mt-1 text-xs text-muted">{item.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
