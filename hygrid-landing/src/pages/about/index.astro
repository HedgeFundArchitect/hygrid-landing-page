---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import Footer from '../../components/Footer.astro';
import { ctaLink } from '../../data/nav';
---

<Layout
  title="About | Hygrid.io"
  description="Hygrid connects Excel to SQL databases and REST APIs, helping Excel users and developers deliver data without exports."
>
  <Header />
  <main>
    <PageHero
      badge="About"
      title="Bridging Excel and your data"
      subtitle="Hygrid was built for teams where applications run on SQL and APIs, but users still live in Excel."
    />

    <section class="pb-24 lg:pb-32">
      <div class="mx-auto max-w-3xl space-y-8 px-6 lg:px-8">
        <div class="reveal rounded-2xl border border-border bg-surface-card p-8">
          <h2 class="font-display text-2xl font-bold text-foreground">Our mission</h2>
          <p class="mt-4 leading-relaxed text-muted">
            We help Excel users and API/SQL developers love each other. If your applications are powered by SQL
            Databases and Web APIs, your users still end up exporting to Excel. Hygrid lets you send them the data
            directly into Excel — no more logging into systems, downloading files, or wrestling with macros.
          </p>
        </div>

        <div class="reveal reveal-delay-1 rounded-2xl border border-border bg-surface-card p-8">
          <h2 class="font-display text-2xl font-bold text-foreground">What Hygrid does</h2>
          <ul class="mt-4 space-y-3 text-muted">
            <li class="flex items-start gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-light"></span>
              Connects Excel to SQL Server, RESTful APIs, QuickBooks, and Salesforce
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-light"></span>
              Lets developers write SQL or API calls once and publish to any Excel user
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-light"></span>
              Gives Excel users a searchable report browser and formula-based data pulls
            </li>
            <li class="flex items-start gap-3">
              <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-light"></span>
              Auto-refreshes pivot tables and delivers 10,000 rows in milliseconds
            </li>
          </ul>
        </div>

        <div class="reveal reveal-delay-2 text-center">
          <a
            href={ctaLink.href}
            class="inline-flex items-center gap-2 rounded-xl bg-brand px-8 py-4 text-base font-semibold text-white shadow-xl shadow-brand/30 transition hover:bg-brand-light"
          >
            Get Hygrid
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
