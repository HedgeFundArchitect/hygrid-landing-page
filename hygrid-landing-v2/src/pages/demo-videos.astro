---
import Layout from '../layouts/Layout.astro';
import { demoVideos } from '../data/site';

const developerVideos = demoVideos.filter((v) => v.category === 'developer');
const excelVideos = demoVideos.filter((v) => v.category === 'excel');
---

<Layout title="Demo Videos | Hygrid.io" description="Watch Hygrid demo videos for developers and Excel users.">
  <section class="page-hero">
    <div class="container">
      <div class="page-hero-content reveal">
        <span class="section-label">Demo Videos</span>
        <h1>See Hygrid in action</h1>
        <p>Watch how developers set up reports and how Excel users pull live data — all without leaving the spreadsheet.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <!-- Developer Experience -->
      <div class="video-section reveal">
        <div class="video-section-header">
          <div class="video-section-icon dev">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <div>
            <h2>Developer Experience</h2>
            <p>Set up SQL reports, parameters, and permissions in minutes.</p>
          </div>
        </div>

        <div class="video-grid">
          {
            developerVideos.map((video) => (
              <div class="video-card reveal">
                <div class="video-embed">
                  <iframe
                    src={`https://www.youtube.com/embed/${video.id}`}
                    title={video.title}
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    loading="lazy"
                  />
                </div>
                <div class="video-info">
                  <h3>{video.title}</h3>
                  <p>{video.description}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Excel User Experience -->
      <div class="video-section reveal">
        <div class="video-section-header">
          <div class="video-section-icon excel">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="9" y1="3" x2="9" y2="21"/><line x1="15" y1="3" x2="15" y2="21"/></svg>
          </div>
          <div>
            <h2>Excel User Experience</h2>
            <p>See how end users run reports, formulas, and refresh pivot tables.</p>
          </div>
        </div>

        <div class="video-grid">
          {
            excelVideos.map((video) => (
              <div class="video-card reveal">
                <div class="video-embed">
                  <iframe
                    src={`https://www.youtube.com/embed/${video.id}`}
                    title={video.title}
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                    loading="lazy"
                  />
                </div>
                <div class="video-info">
                  <h3>{video.title}</h3>
                  <p>{video.description}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="cta-inline reveal">
        <p>Ready to try it yourself?</p>
        <a href="/get-hygrid" class="btn btn-primary">Start 30-Day Trial</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding: 4rem 0 2rem;
    background: var(--color-bg-hero);
  }

  .page-hero-content {
    text-align: center;
    max-width: 640px;
    margin: 0 auto;
  }

  .page-hero-content h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .page-hero-content p {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .section-label {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    background: var(--color-primary-glow);
    padding: 0.375rem 0.875rem;
    border-radius: 100px;
    margin-bottom: 1rem;
  }

  .video-section {
    margin-bottom: 4rem;
  }

  .video-section:last-child {
    margin-bottom: 0;
  }

  .video-section-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .video-section-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .video-section-icon.dev {
    background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
    color: white;
  }

  .video-section-icon.excel {
    background: linear-gradient(135deg, #217346, #33a867);
    color: white;
  }

  .video-section-header h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.25rem;
  }

  .video-section-header p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .video-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .video-grid {
      grid-template-columns: repeat(auto-fit, minmax(480px, 1fr));
    }
  }

  .video-card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: all var(--transition);
  }

  .video-card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .video-embed {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    background: var(--color-bg-muted);
  }

  .video-embed iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video-info {
    padding: 1.5rem;
  }

  .video-info h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  .video-info p {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .cta-inline {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
    padding: 2rem;
  }

  .cta-inline p {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
  }
</style>
